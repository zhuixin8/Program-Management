# Copy this file to .env.server on the VPS before running docker compose.
# The image is built by GitHub Actions and pulled by the server.

DOCKER_IMAGE=ghcr.io/zhuixin8/program-management:latest
HOST_PORT=3010
DATA_DIR=/opt/activation-manager-data

# Replace with a long random value before production use.
JWT_SECRET=please-change-me-to-a-long-random-secret

# Use * for the first deployment if the reverse proxy passes real client IPs.
# Tighten this after login, for example:
# ALLOWED_IPS=127.0.0.1,::1,203.0.113.10
ALLOWED_IPS=*
