generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                           Int                            @id @default(autoincrement())
  name                         String
  projectKey                   String                         @unique
  apiSecret                    String?
  licenseV2OfflinePrivateKeyBase64 String?
  licenseV2OfflinePublicKey    String?
  licenseV2OfflineKeyCreatedAt DateTime?
  description                  String?
  isEnabled                    Boolean                        @default(true)
  allowAutoRebind              Boolean?
  autoRebindCooldownMinutes    Int?
  autoRebindMaxCount           Int?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  codes                        ActivationCode[]
  bindingHistories             ActivationCodeBindingHistory[]
  adminAuditLogs               AdminOperationAuditLog[]
  licenseApiNonces             LicenseApiNonce[]
  licenseDevices               LicenseDevice[]
  blockedClientVersions        BlockedClientVersion[]
  licenseSecurityEvents        LicenseSecurityEvent[]

  @@map("projects")
}

model ActivationCode {
  id                           Int                            @id @default(autoincrement())
  code                         String                         @unique
  isUsed                       Boolean                        @default(false)
  usedAt                       DateTime?
  usedBy                       String?
  lastBoundAt                  DateTime?
  lastRebindAt                 DateTime?
  rebindCount                  Int                            @default(0)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  expiresAt                    DateTime?
  validDays                    Int?
  cardType                     String?
  projectId                    Int
  project                      Project                        @relation(fields: [projectId], references: [id])
  licenseMode                  String                         @default("TIME")
  totalCount                   Int?
  remainingCount               Int?
  consumedCount                Int                            @default(0)
  allowAutoRebind              Boolean?
  autoRebindCooldownMinutes    Int?
  autoRebindMaxCount           Int?
  autoRebindCount              Int                            @default(0)
  consumptions                 LicenseConsumption[]
  bindingHistories             ActivationCodeBindingHistory[]
  adminAuditLogs               AdminOperationAuditLog[]
  licenseDevices               LicenseDevice[]
  licenseSecurityEvents        LicenseSecurityEvent[]

  @@unique([projectId, usedBy], map: "activation_codes_projectId_usedBy_key")
  @@index([projectId], map: "activation_codes_projectId_idx")
  @@index([projectId, usedBy, isUsed, usedAt], map: "activation_codes_projectId_usedBy_isUsed_usedAt_idx")
  @@map("activation_codes")
}

model ActivationCodeBindingHistory {
  id                    Int            @id @default(autoincrement())
  activationCodeId      Int
  activationCode        ActivationCode @relation(fields: [activationCodeId], references: [id])
  projectId             Int
  project               Project        @relation(fields: [projectId], references: [id])
  eventType             String
  operatorType          String
  operatorUsername      String?
  fromMachineId         String?
  toMachineId           String?
  reason                String?
  createdAt             DateTime       @default(now())

  @@index([activationCodeId, createdAt], map: "ac_binding_histories_code_created_idx")
  @@index([projectId, createdAt], map: "ac_binding_histories_project_created_idx")
  @@map("activation_code_binding_histories")
}

model AdminOperationAuditLog {
  id                    Int             @id @default(autoincrement())
  adminUsername         String
  operationType         String
  activationCodeId      Int?
  activationCode        ActivationCode? @relation(fields: [activationCodeId], references: [id])
  projectId             Int?
  project               Project?        @relation(fields: [projectId], references: [id])
  targetLabel           String?
  reason                String?
  detailJson            String?
  createdAt             DateTime        @default(now())

  @@index([activationCodeId, createdAt], map: "admin_operation_audit_logs_activationCodeId_createdAt_idx")
  @@index([projectId, createdAt], map: "admin_operation_audit_logs_projectId_createdAt_idx")
  @@index([adminUsername, createdAt], map: "admin_operation_audit_logs_adminUsername_createdAt_idx")
  @@map("admin_operation_audit_logs")
}

model LicenseConsumption {
  id                    Int            @id @default(autoincrement())
  requestId             String         @unique
  activationCodeId      Int
  activationCode        ActivationCode @relation(fields: [activationCodeId], references: [id])
  machineId             String
  remainingCountAfter   Int
  createdAt             DateTime       @default(now())

  @@index([activationCodeId], map: "license_consumptions_activationCodeId_idx")
  @@index([activationCodeId, createdAt], map: "license_consumptions_activationCodeId_createdAt_idx")
  @@index([createdAt, id], map: "license_consumptions_createdAt_id_idx")
  @@map("license_consumptions")
}

model Admin {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  password     String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admins")
}

model AdminLoginRateLimitState {
  id           Int       @id @default(autoincrement())
  key          String    @unique
  failuresJson String    @default("[]")
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("admin_login_rate_limits")
}

model LicenseApiRateLimitState {
  id              Int      @id @default(autoincrement())
  key             String   @unique
  count           Int      @default(0)
  windowStartedAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([windowStartedAt], map: "license_api_rate_limits_windowStartedAt_idx")
  @@map("license_api_rate_limits")
}

model LicenseApiNonce {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id])
  nonce     String
  createdAt DateTime @default(now())

  @@unique([projectId, nonce], map: "license_api_nonces_projectId_nonce_key")
  @@index([createdAt], map: "license_api_nonces_createdAt_idx")
  @@map("license_api_nonces")
}

model LicenseDevice {
  id                    Int                    @id @default(autoincrement())
  projectId             Int
  project               Project                @relation(fields: [projectId], references: [id])
  activationCodeId      Int
  activationCode        ActivationCode         @relation(fields: [activationCodeId], references: [id])
  machineId             String
  publicKey             String
  publicKeyFingerprint  String
  fingerprintHash       String?
  appVersion            String?
  status                String                 @default("ACTIVE")
  revokedAt             DateTime?
  lastSeenAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sessions              LicenseSession[]
  challenges            LicenseChallenge[]
  securityEvents        LicenseSecurityEvent[]

  @@unique([projectId, machineId], map: "license_devices_projectId_machineId_key")
  @@index([activationCodeId, status], map: "license_devices_activationCodeId_status_idx")
  @@index([publicKeyFingerprint], map: "license_devices_publicKeyFingerprint_idx")
  @@map("license_devices")
}

model LicenseSession {
  id             Int                    @id @default(autoincrement())
  sessionId      String                 @unique
  deviceId       Int
  device         LicenseDevice          @relation(fields: [deviceId], references: [id])
  status         String                 @default("ACTIVE")
  tokenVersion   Int                    @default(0)
  expiresAt      DateTime
  lastRenewedAt  DateTime?
  revokedAt      DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  securityEvents LicenseSecurityEvent[]

  @@index([deviceId, status], map: "license_sessions_deviceId_status_idx")
  @@index([expiresAt], map: "license_sessions_expiresAt_idx")
  @@map("license_sessions")
}

model LicenseChallenge {
  id          Int           @id @default(autoincrement())
  challengeId String        @unique
  deviceId    Int
  device      LicenseDevice @relation(fields: [deviceId], references: [id])
  nonce       String        @unique
  purpose     String        @default("RENEW")
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([deviceId, createdAt], map: "license_challenges_deviceId_createdAt_idx")
  @@index([expiresAt], map: "license_challenges_expiresAt_idx")
  @@map("license_challenges")
}

model BlockedClientVersion {
  id         Int      @id @default(autoincrement())
  projectId  Int
  project    Project  @relation(fields: [projectId], references: [id])
  appVersion String
  reason     String?
  createdAt  DateTime @default(now())

  @@unique([projectId, appVersion], map: "blocked_client_versions_projectId_appVersion_key")
  @@index([projectId], map: "blocked_client_versions_projectId_idx")
  @@map("blocked_client_versions")
}

model LicenseSecurityEvent {
  id                Int              @id @default(autoincrement())
  projectId          Int?
  project            Project?         @relation(fields: [projectId], references: [id])
  activationCodeId   Int?
  activationCode     ActivationCode?  @relation(fields: [activationCodeId], references: [id])
  deviceId           Int?
  device             LicenseDevice?   @relation(fields: [deviceId], references: [id])
  licenseSessionId   Int?
  licenseSession     LicenseSession?  @relation(fields: [licenseSessionId], references: [id])
  eventType          String
  severity           String           @default("INFO")
  ip                 String?
  userAgent          String?
  detailJson         String?
  createdAt          DateTime         @default(now())

  @@index([projectId, createdAt], map: "license_security_events_projectId_createdAt_idx")
  @@index([deviceId, createdAt], map: "license_security_events_deviceId_createdAt_idx")
  @@index([eventType, createdAt], map: "license_security_events_eventType_createdAt_idx")
  @@map("license_security_events")
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}
